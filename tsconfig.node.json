{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.kuromoji-plugin.ts",
    "vite.react-plugin.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/i18n/**/*",
    "src/types/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    // Node's test runner resolves ESM specifiers verbatim, so the test file imports
    // "./mpv-lifecycle.ts" with its extension. Type checking runs with --noEmit.
    "allowImportingTsExtensions": true,
    "types": ["electron-vite/node"],
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "/@/main/*": [
        "src/main/*"
      ],
      "/@/preload/*": [
        "src/preload/*"
      ],
      "/@/shared/*": [
        "src/shared/*"
      ],
    }
  }
}
